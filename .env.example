# ==============================================================================
# AutoCanvas SaaS — Master Environment Configuration Template
# ==============================================================================

# Application Environment
APP_NAME=AutoCanvas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
RENDERER_URL=http://localhost:3001

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Relational Database (MySQL 8.0 Primary / SQLite for Fast Testing)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autocanvas
DB_USERNAME=root
DB_PASSWORD=

# Cache, Sessions & Queues (Redis)
CACHE_STORE=redis
CACHE_PREFIX=autocanvas_cache_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Object Storage (Cloudflare R2 or Local MinIO/S3)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=autocanvas-assets
AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI Provider Gateway Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AI_DEFAULT_TEXT_PROVIDER=anthropic
AI_DEFAULT_TEXT_MODEL=claude-sonnet-4-5
AI_DEFAULT_CHEAP_MODEL=gpt-4o-mini
AI_DEFAULT_IMAGE_PROVIDER=openai

# Social Media API Integration Credentials
# Meta (Facebook Pages & Instagram Professional)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI="${APP_URL}/api/v1/connectors/meta/callback"

# LinkedIn Company Pages
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/api/v1/connectors/linkedin/callback"

# TikTok (Future - Phase 8)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X / Twitter (Future - Phase 8)
X_CLIENT_ID=
X_CLIENT_SECRET=

# YouTube / Google Data API (Future - Phase 8)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing & Entitlements (Stripe)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Mail Service (Local Mailpit/Mailhog or Production cPanel SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.devcenterpoint.com
MAIL_PORT=465
MAIL_USERNAME=hello@devcenterpoint.com
MAIL_PASSWORD=Hello@DCP2026
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="hello@devcenterpoint.com"
MAIL_FROM_NAME="${APP_NAME}"

